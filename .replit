run = "cd frontend && npm run dev"
entrypoint = "frontend/src/main.tsx"
hidden = [".git", "node_modules", "frontend/node_modules", "server/node_modules"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "cd frontend && npm run build && npm run preview -- --host 0.0.0.0 --port 3000"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000
